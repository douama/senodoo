<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Le partage est applique par des regles d'enregistrement, donc cote
          SERVEUR. Masquer le bouton dans l'interface ne suffirait pas : un
          appel JSON-RPC direct contournerait la restriction.
        -->

        <record id="rule_article_read" model="ir.rule">
            <field name="name">Article : lecture selon le partage</field>
            <field name="model_id" ref="model_senodoo_knowledge_article"/>
            <field name="domain_force">['|', ('internal_permission', 'in', ['read', 'write']), ('author_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_article_write" model="ir.rule">
            <field name="name">Article : edition selon le partage</field>
            <field name="model_id" ref="model_senodoo_knowledge_article"/>
            <field name="domain_force">['|', ('internal_permission', '=', 'write'), ('author_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supprimer reste le geste le plus destructeur : reserve a l'auteur. -->
        <record id="rule_article_unlink" model="ir.rule">
            <field name="name">Article : suppression par l'auteur</field>
            <field name="model_id" ref="model_senodoo_knowledge_article"/>
            <field name="domain_force">[('author_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_article_manager" model="ir.rule">
            <field name="name">Article : acces complet pour l'administrateur</field>
            <field name="model_id" ref="model_senodoo_knowledge_article"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('senodoo_knowledge.group_knowledge_manager'))]"/>
        </record>
    </data>
</odoo>
