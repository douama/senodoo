<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 19 : les groupes se rattachent a un `res.groups.privilege`,
             qui porte lui-meme la categorie de module (res_groups.py). -->
        <record id="res_groups_privilege_knowledge" model="res.groups.privilege">
            <field name="name">Connaissances</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_knowledge_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_knowledge"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Peut lire, modifier et supprimer tout article, y compris les articles prives des autres utilisateurs.</field>
        </record>
    </data>
</odoo>
