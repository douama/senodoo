<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_base_document_layout_letterhead" model="ir.ui.view">
        <field name="name">base.document.layout.form.letterhead</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout"/>
        <field name="arch" type="xml">
            <field name="report_footer" position="after">
                <field name="is_letterhead_layout" invisible="1"/>
                <field name="letterhead_header_image" string="Image d'en-tête"
                       widget="image" options="{'size': [0, 50]}"
                       invisible="not is_letterhead_layout"
                       help="Remplace le logo, l'adresse et le slogan en haut de chaque page. Largeur conseillée : 2480 px (A4 à 300 dpi). Hauteur affichée : 38 mm au plus."/>
                <field name="letterhead_footer_image" string="Image de pied de page"
                       widget="image" options="{'size': [0, 50]}"
                       invisible="not is_letterhead_layout"
                       help="S'affiche en bas de chaque page, sous le texte du pied de page et la numérotation. Hauteur affichée : 17 mm au plus."/>
            </field>
        </field>
    </record>

</odoo>
