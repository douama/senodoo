<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="senodoo_document_folder_view_list" model="ir.ui.view">
        <field name="name">senodoo.document.folder.list</field>
        <field name="model">senodoo.document.folder</field>
        <field name="arch" type="xml">
            <list string="Espaces de travail">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="full_path" optional="hide"/>
                <field name="parent_id" optional="show"/>
                <field name="document_count" string="Documents"/>
                <field name="group_ids" widget="many2many_tags" string="Restreint a" optional="show"/>
            </list>
        </field>
    </record>

    <record id="senodoo_document_folder_view_form" model="ir.ui.view">
        <field name="name">senodoo.document.folder.form</field>
        <field name="model">senodoo.document.folder</field>
        <field name="arch" type="xml">
            <form string="Espace de travail">
                <header>
                    <button name="action_archive_tree" type="object"
                            string="Archiver avec son contenu" class="btn-secondary"
                            invisible="not id or not active"
                            confirm="Archiver cet espace, ses sous-espaces et leurs documents ?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archive" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-file-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Contrats, Factures, RH…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" domain="[('id', '!=', id)]"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="group_ids">
                        Aucun groupe : cet espace est visible par tous les
                        utilisateurs internes.
                    </div>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="À quoi sert cet espace ?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="senodoo_document_folder_action" model="ir.actions.act_window">
        <field name="name">Espaces de travail</field>
        <field name="res_model">senodoo.document.folder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un espace de travail</p>
            <p>Un espace regroupe des documents et peut être réservé à certains
               groupes d'utilisateurs. Les espaces s'imbriquent sans limite.</p>
        </field>
    </record>

    <record id="senodoo_document_tag_action" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">senodoo.document.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
