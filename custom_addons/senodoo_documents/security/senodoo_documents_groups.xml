<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_documents" model="res.groups.privilege">
            <field name="name">Documents</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_documents_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_documents"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Depose et classe des documents dans les espaces auxquels il a acces.</field>
        </record>

        <record id="group_documents_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_documents"/>
            <field name="implied_ids" eval="[(4, ref('senodoo_documents.group_documents_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Gere les espaces de travail et accede a tous les documents.</field>
        </record>
    </data>
</odoo>
