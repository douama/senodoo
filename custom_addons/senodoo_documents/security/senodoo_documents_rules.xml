<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          La restriction d'un espace de travail est appliquee ICI, au niveau
          des enregistrements. Se contenter de masquer un menu laisserait un
          appel JSON-RPC direct lire n'importe quel document.

          Un espace sans groupe est ouvert a tous les internes ; sinon il faut
          appartenir a l'un des groupes, ou etre proprietaire du document.
          `all_group_ids` et non `group_ids` : les groupes impliques comptent.
        -->
        <record id="rule_document_user" model="ir.rule">
            <field name="name">Document : acces selon l'espace de travail</field>
            <field name="model_id" ref="model_senodoo_document"/>
            <field name="domain_force">['|', '|', ('folder_id.group_ids', '=', False), ('folder_id.group_ids', 'in', user.all_group_ids.ids), ('owner_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('senodoo_documents.group_documents_user'))]"/>
        </record>

        <record id="rule_document_manager" model="ir.rule">
            <field name="name">Document : acces complet pour l'administrateur</field>
            <field name="model_id" ref="model_senodoo_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('senodoo_documents.group_documents_manager'))]"/>
        </record>

        <record id="rule_folder_user" model="ir.rule">
            <field name="name">Espace : visible selon les groupes</field>
            <field name="model_id" ref="model_senodoo_document_folder"/>
            <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('senodoo_documents.group_documents_user'))]"/>
        </record>

        <record id="rule_folder_manager" model="ir.rule">
            <field name="name">Espace : acces complet pour l'administrateur</field>
            <field name="model_id" ref="model_senodoo_document_folder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('senodoo_documents.group_documents_manager'))]"/>
        </record>
    </data>
</odoo>
