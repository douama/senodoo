<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_marketing_automation" model="res.groups.privilege">
            <field name="name">Marketing Automation</field>
            <field name="sequence">45</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_marketing_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_marketing_automation"/>
            <field name="implied_ids" eval="[(4, ref('mass_mailing.group_mass_mailing_user'))]"/>
            <field name="comment">Consulte les campagnes et leurs participants.</field>
        </record>

        <record id="group_marketing_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_marketing_automation"/>
            <field name="implied_ids" eval="[(4, ref('senodoo_marketing_automation.group_marketing_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Crée, démarre et arrête les campagnes.</field>
        </record>
    </data>
</odoo>
