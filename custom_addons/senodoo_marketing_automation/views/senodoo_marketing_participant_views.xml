<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="senodoo_marketing_trace_view_list" model="ir.ui.view">
        <field name="name">senodoo.marketing.trace.list</field>
        <field name="model">senodoo.marketing.trace</field>
        <field name="arch" type="xml">
            <list string="Traces" create="false"
                  decoration-success="state == 'processed'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'canceled'">
                <field name="schedule_date"/>
                <field name="activity_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'scheduled'"/>
                <field name="state_msg" string="Motif"/>
            </list>
        </field>
    </record>

    <record id="senodoo_marketing_participant_view_list" model="ir.ui.view">
        <field name="name">senodoo.marketing.participant.list</field>
        <field name="model">senodoo.marketing.participant</field>
        <field name="arch" type="xml">
            <list string="Participants" create="false">
                <field name="display_name" string="Enregistrement"/>
                <field name="campaign_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'running'"/>
            </list>
        </field>
    </record>

    <record id="senodoo_marketing_participant_view_form" model="ir.ui.view">
        <field name="name">senodoo.marketing.participant.form</field>
        <field name="model">senodoo.marketing.participant</field>
        <field name="arch" type="xml">
            <form string="Participant" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="campaign_id" readonly="1"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="model_name" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parcours" name="traces">
                            <field name="trace_ids" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="senodoo_marketing_participant_action" model="ir.actions.act_window">
        <field name="name">Participants</field>
        <field name="res_model">senodoo.marketing.participant</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
