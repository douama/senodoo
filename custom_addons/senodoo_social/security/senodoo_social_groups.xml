<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_social" model="res.groups.privilege">
            <field name="name">Marketing social</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_social_user" model="res.groups">
            <field name="name">Redacteur</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_social"/>
            <field name="comment">Redige et planifie des publications. Ne voit pas les jetons d'acces.</field>
        </record>

        <record id="group_social_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_social"/>
            <field name="implied_ids" eval="[(4, ref('senodoo_social.group_social_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Gere les comptes et leurs jetons d'acces.</field>
        </record>
    </data>
</odoo>
