<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_social_root"
              name="Marketing social"
              web_icon="base,static/img/icons/social.png"
              sequence="95"/>

    <!-- Le tableau de bord est la porte d'entree : on ouvre l'application sur
         ce qui demande une action, pas sur une liste brute. -->
    <menuitem id="menu_social_dashboard"
              name="Vue d'ensemble"
              parent="menu_social_root"
              action="senodoo_social_dashboard_action"
              sequence="5"/>

    <menuitem id="menu_social_posts"
              name="Publications"
              parent="menu_social_root"
              action="senodoo_social_post_action"
              sequence="10"/>

    <menuitem id="menu_social_configuration"
              name="Configuration"
              parent="menu_social_root"
              sequence="90"
              groups="senodoo_social.group_social_manager"/>

    <menuitem id="menu_social_accounts"
              name="Comptes"
              parent="menu_social_configuration"
              action="senodoo_social_account_action"
              sequence="10"/>
</odoo>
