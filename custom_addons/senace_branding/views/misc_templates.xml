<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      /cookie-policy est une page publique. Sa colonne « Cookies utilises »
      nomme l'editeur six fois, une par cookie : « session_id (Odoo) »,
      « frontend_lang (Odoo) », et les quatre de la ligne suivante. Seule la
      parenthese part ; le nom technique du cookie reste exact, sinon le
      tableau ne documenterait plus rien.

      Les trois cellules sont reprises ici plutot que laissees au correcteur
      de `senace.views` : celui-ci epargne les vues que nous heritons
      nous-memes, pour ne pas desancrer nos propres xpath.
    -->
    <template id="senace_cookie_policy" inherit_id="website.cookie_policy"
              name="Politique de cookies SEN ACE">
        <xpath expr="//td[contains(text(), 'session_id')]" position="replace">
            <td>
                session_id<br/>
            </td>
        </xpath>
        <xpath expr="//td[contains(text(), 'frontend_lang')]" position="replace">
            <td>
                frontend_lang
            </td>
        </xpath>
        <xpath expr="//td[contains(text(), 'im_livechat_previous_operator')]" position="replace">
            <td>
                im_livechat_previous_operator<br/>
                utm_campaign<br/>
                utm_source<br/>
                utm_medium
            </td>
        </xpath>
    </template>

    <!--
      Page publique d'un canal de discussion partage : son titre d'onglet
      retombe sur « Odoo » comme le client web, et elle sert son propre
      gabarit, hors de `web.layout`.
    -->
    <template id="senace_discuss_public" inherit_id="mail.discuss_public_channel_template"
              name="Discussion publique SEN ACE">
        <xpath expr="//head/title" position="replace">
            <title t-out="title or 'SEN ACE'"/>
        </xpath>
        <xpath expr="//head/link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/senace_branding/static/src/img/favicon.png'</attribute>
        </xpath>
    </template>

    <!--
      Nom du bloc dans le selecteur de mega-menu de l'editeur de site. C'est
      le champ `name` de la vue qui s'affiche, pas son contenu : un heritage
      par xpath ne l'atteindrait pas.
    -->
    <record id="website.s_mega_menu_odoo_menu" model="ir.ui.view">
        <field name="name">Menu en colonnes</field>
    </record>

</odoo>
