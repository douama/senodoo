<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      « Powered by Odoo » en bas de chaque e-mail sortant : accuses de
      reception du formulaire de contact, notifications de suivi, devis.
      C'est la mention la plus diffusee des deux, puisqu'elle part chez le
      destinataire et non sur nos propres pages.

      Le conteneur est vise par son unique repere stable, le span
      `mail_unfollow`, et reconstruit avec le seul lien de desabonnement :
      un xpath sur le texte « Powered by » ne serait pas adressable, et
      l'element porteur n'a ni identifiant ni classe.
    -->
    <template id="senace_mail_layout" inherit_id="mail.mail_notification_layout"
              name="E-mails sans marque éditeur">
        <xpath expr="//span[@id='mail_unfollow']/.." position="replace">
            <div t-if="show_footer and show_unfollow" style="color: #555555; font-size:11px;">
                <span id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Se désabonner</a>
                </span>
            </div>
        </xpath>
    </template>

    <!-- Meme mention dans la variante allegee (notifications de discussion). -->
    <template id="senace_mail_layout_light" inherit_id="mail.mail_notification_light"
              name="E-mails allégés sans marque éditeur">
        <xpath expr="//span[@id='mail_unfollow']/.." position="replace">
            <td align="center" style="min-width: 590px;">
                <span t-if="show_unfollow" id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Se désabonner</a>
                </span>
            </td>
        </xpath>
    </template>

</odoo>
