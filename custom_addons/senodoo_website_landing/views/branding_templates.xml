<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Une classe stable permet de donner a l'en-tete Odoo une finition
         SENACE sans dependre du theme actif. -->
    <template id="senace_layout_branding" inherit_id="website.layout"
              name="Identité visuelle SENACE">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="s_senace_site_header" separator=" "/>
        </xpath>
    </template>

    <!--
      Le logo de l'en-tete vient de `website.logo`, comme dans le template
      d'origine d'Odoo : il reste donc modifiable depuis l'editeur de site,
      sans toucher au code. Le fichier livre par le module en fournit la
      valeur de depart.

      width/height sont poses sur l'image pour reserver la place pendant le
      chargement : sans eux le menu se decale au moment ou l'image arrive.
      Le CSS impose ensuite la hauteur reelle et une largeur automatique.
    -->
    <template id="senace_header_wordmark" inherit_id="website.option_header_brand_logo"
              name="Logo SENACE" priority="30">
        <xpath expr="//a[@data-name='Navbar Logo']" position="replace">
            <a data-name="Navbar Logo" href="/"
               t-attf-class="navbar-brand s_senace_logo #{_link_class}">
                <t t-set="base_options" t-value="{'widget': 'image'}"/>
                <span t-field="website.logo"
                      t-options="base_options if editable else dict(base_options, width=152, height=40)"
                      role="img"
                      t-att-aria-label="'Logo de %s' % website.name"
                      t-att-title="website.name"/>
            </a>
        </xpath>
    </template>

    <!--
      Le bloc #footer d'Odoo porte t-ignore="true" : les directives QWeb n'y
      sont pas evaluees, `t-field` n'y fonctionnerait pas. Les coordonnees y
      sont donc ecrites litteralement, exactement comme l'editeur de site les
      enregistrerait. Elles restent modifiables dans le builder.
    -->
    <template id="senace_footer" inherit_id="website.footer_custom" name="Pied de page SENACE">
        <xpath expr="//div[@id='footer']/section[1]" position="replace">
            <section class="s_text_block pt40 pb16 s_senace_footer" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4 pt24 pb24">
                            <h5>SENACE</h5>
                            <p>
                                Quatre expertises complémentaires : formation professionnelle,
                                coaching, services aux entreprises et services au tourisme.
                                Un seul interlocuteur, du premier échange jusqu'au bilan.
                            </p>
                        </div>
                        <div class="col-lg-3 offset-lg-1 pt24 pb24">
                            <h5>Nos pôles</h5>
                            <ul class="list-unstyled">
                                <li><a href="/#formation">Formation professionnelle</a></li>
                                <li><a href="/#coaching">Coaching professionnel</a></li>
                                <li><a href="/#entreprises">Services aux entreprises</a></li>
                                <li><a href="/#tourisme">Services au tourisme</a></li>
                                <li><a href="/contactus">Demander un devis</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4 pt24 pb24">
                            <h5>Nous joindre</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <i class="fa fa-phone fa-fw me-2"/>
                                    <a href="tel:+221762601987"><span class="o_force_ltr">76 260 19 87</span></a>
                                    <span class="mx-1">·</span>
                                    <a href="tel:+221774315931"><span class="o_force_ltr">77 431 59 31</span></a>
                                </li>
                                <li>
                                    <i class="fa fa-envelope fa-fw me-2"/>
                                    <a href="mailto:kadycoulibaly43@yahoo.fr">kadycoulibaly43@yahoo.fr</a>
                                </li>
                                <li>
                                    <i class="fa fa-map-marker fa-fw me-2"/>
                                    Keur Massar, Dakar — Sénégal
                                </li>
                                <li class="mt-2">
                                    <i class="fa fa-comment fa-fw me-2"/>
                                    <a href="/contactus">Nous écrire</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!--
      La mention « Genere par Odoo - Creer un site web gratuit » est retiree du
      pied de page. La licence LGPL-3 d'Odoo l'autorise. On supprime la colonne
      entiere qui la porte : la colonne « Copyright (c) SENACE » reste seule.
    -->
    <template id="senace_no_brand_promotion" inherit_id="website.layout"
              name="Pied de page sans mention Odoo" priority="99">
        <xpath expr="//t[@t-call='web.brand_promotion']/.." position="replace"/>
    </template>

    <!-- « Copyright © Company name » -> la marque reelle. -->
    <template id="senace_copyright" inherit_id="website.footer_copyright_company_name"
              name="Copyright SENACE">
        <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2 small">Copyright © SENACE</span>
        </xpath>
    </template>

    <!--
      Le telephone de l'en-tete est un exemple d'Odoo (+1 555-555-5556).
      On desactive le bloc d'origine et on fournit le notre : une inheritance
      par xpath profond dans ce template serait fragile.
    -->
    <record id="website.header_text_element" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <template id="senace_header_phone" inherit_id="website.placeholder_header_text_element"
              name="Téléphone SENACE dans l'en-tête">
        <xpath expr="." position="inside">
            <li t-attf-class="#{_item_class}">
                <div t-attf-class="s_text_block d-flex align-items-center #{_div_class}" data-name="Text">
                    <a href="tel:+221762601987" class="d-flex align-items-center text-reset text-decoration-none">
                        <i class="fa fa-fw fa-phone me-2" role="img" aria-label="Téléphone"/>
                        <span class="o_force_ltr">76 260 19 87</span>
                    </a>
                </div>
            </li>
        </xpath>
    </template>

    <!-- Le CTA fourni par Odoo est en anglais par defaut. -->
    <template id="senace_header_cta" inherit_id="website.header_call_to_action"
              name="Appel à l'action SENACE">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/contactus"
               class="oe_unremovable btn btn_cta s_senace_header_cta">
                Démarrer un projet
            </a>
        </xpath>
    </template>

</odoo>
