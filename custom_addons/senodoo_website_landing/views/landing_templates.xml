<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="landing_homepage" inherit_id="website.homepage" name="Accueil SENACE">
        <!--
          La classe `oe_structure` est volontairement conservee : le contenu
          reste accessible depuis l'editeur de site Odoo.
        -->
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure s_senace">

                <!-- ============ Hero editorial ============ -->
                <section class="s_senace_hero" aria-labelledby="senace-hero-title">
                    <div class="s_senace_hero_media" aria-hidden="true">
                        <img src="/senodoo_website_landing/static/src/img/senace-hero.webp"
                             alt="" width="1536" height="1024" fetchpriority="high"
                             decoding="async" loading="eager"/>
                    </div>
                    <div class="container s_senace_hero_inner">
                        <div class="row">
                            <div class="col-lg-9 col-xl-8">
                                <p class="s_senace_eyebrow">
                                    <span class="s_senace_eyebrow_mark" aria-hidden="true"/>
                                    Dakar · Sénégal
                                </p>
                                <h1 id="senace-hero-title" class="s_senace_title">
                                    Quatre expertises pour
                                    <span>donner de l'élan</span>
                                    à vos ambitions.
                                </h1>
                                <p class="s_senace_lead">
                                    SENACE forme, conseille et accompagne les professionnels,
                                    les organisations et les porteurs de projet avec une approche
                                    claire, humaine et résolument tournée vers l'action.
                                </p>
                                <div class="s_senace_hero_actions">
                                    <a href="/contactus" class="btn s_senace_btn_primary">
                                        Parler de mon projet
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                    <a href="#poles" class="btn s_senace_btn_ghost">
                                        Découvrir nos expertises
                                    </a>
                                </div>
                                <ul class="s_senace_hero_poles list-unstyled"
                                    aria-label="Les quatre pôles SENACE">
                                    <li><span>01</span> Formation</li>
                                    <li><span>02</span> Coaching</li>
                                    <li><span>03</span> Entreprises</li>
                                    <li><span>04</span> Tourisme</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <a href="#poles" class="s_senace_scroll" aria-label="Aller aux expertises">
                        <span>Explorer</span>
                        <i class="fa fa-arrow-down" aria-hidden="true"/>
                    </a>
                </section>

                <!-- ============ Reassurance ============ -->
                <section class="s_senace_trust" aria-label="Les engagements SENACE">
                    <div class="container">
                        <div class="s_senace_trust_inner">
                            <div class="s_senace_trust_intro">
                                <span>Notre engagement</span>
                                <strong>Vous faire avancer, avec méthode.</strong>
                            </div>
                            <div class="s_senace_trust_item">
                                <span class="s_senace_trust_num">01</span>
                                <p><strong>Un interlocuteur dédié</strong> du premier échange au bilan.</p>
                            </div>
                            <div class="s_senace_trust_item">
                                <span class="s_senace_trust_num">02</span>
                                <p><strong>Une proposition lisible</strong> avant chaque intervention.</p>
                            </div>
                            <div class="s_senace_trust_item">
                                <span class="s_senace_trust_num">03</span>
                                <p><strong>Un suivi continu</strong> pour transformer l'élan en résultats.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ Les quatre poles ============ -->
                <section id="poles" class="s_senace_section s_senace_expertises"
                         aria-labelledby="senace-poles-title">
                    <div class="container">
                        <div class="row align-items-end g-4 s_senace_section_head">
                            <div class="col-lg-8">
                                <p class="s_senace_kicker">Un partenaire, quatre savoir-faire</p>
                                <h2 id="senace-poles-title">
                                    Votre besoin ne tient pas toujours dans une case.
                                    <span>Notre accompagnement non plus.</span>
                                </h2>
                            </div>
                            <div class="col-lg-3 offset-lg-1">
                                <p class="s_senace_section_intro">
                                    Nos expertises se complètent pour vous proposer le bon appui,
                                    au bon moment, sans multiplier les interlocuteurs.
                                </p>
                            </div>
                        </div>

                        <div class="s_senace_poles_grid">
                            <article id="formation" class="s_senace_pole s_senace_pole--formation">
                                <div class="s_senace_pole_copy">
                                    <p class="s_senace_pole_overline"><span>01</span> Développer</p>
                                    <h3>Formation professionnelle</h3>
                                    <p>
                                        Des parcours conçus pour devenir rapidement utiles :
                                        apprendre, pratiquer et appliquer dès le retour au poste.
                                    </p>
                                    <ul class="list-unstyled s_senace_pole_points">
                                        <li>Montée en compétences</li>
                                        <li>Perfectionnement</li>
                                        <li>Reconversion professionnelle</li>
                                    </ul>
                                    <a href="/contactus?subject=Formation professionnelle"
                                       class="s_senace_link">
                                        Demander le programme
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                                <div class="s_senace_pole_visual" aria-hidden="true">
                                    <img src="/senodoo_website_landing/static/src/img/icon-formation.webp"
                                         alt="" width="512" height="512" loading="lazy"
                                         decoding="async"/>
                                </div>
                            </article>

                            <article id="coaching" class="s_senace_pole s_senace_pole--coaching">
                                <div class="s_senace_pole_copy">
                                    <p class="s_senace_pole_overline"><span>02</span> Clarifier</p>
                                    <h3>Coaching professionnel</h3>
                                    <p>
                                        Un espace exigeant et bienveillant pour prendre du recul,
                                        franchir un cap et agir avec davantage de justesse.
                                    </p>
                                    <ul class="list-unstyled s_senace_pole_points">
                                        <li>Accompagnement individuel</li>
                                        <li>Dynamique d'équipe</li>
                                        <li>Conduite du changement</li>
                                    </ul>
                                    <a href="/contactus?subject=Coaching professionnel"
                                       class="s_senace_link">
                                        Réserver un échange
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                                <div class="s_senace_pole_visual" aria-hidden="true">
                                    <img src="/senodoo_website_landing/static/src/img/icon-coaching.webp"
                                         alt="" width="512" height="512" loading="lazy"
                                         decoding="async"/>
                                </div>
                            </article>

                            <article id="entreprises" class="s_senace_pole s_senace_pole--entreprises">
                                <div class="s_senace_pole_copy">
                                    <p class="s_senace_pole_overline"><span>03</span> Structurer</p>
                                    <h3>Services aux entreprises</h3>
                                    <p>
                                        Un soutien fiable pour simplifier vos démarches, structurer
                                        l'administratif et laisser plus de place à votre activité.
                                    </p>
                                    <ul class="list-unstyled s_senace_pole_points">
                                        <li>Assistance administrative</li>
                                        <li>Appui à la création</li>
                                        <li>Organisation et suivi</li>
                                    </ul>
                                    <a href="/contactus?subject=Services aux entreprises"
                                       class="s_senace_link">
                                        Exposer mon besoin
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                                <div class="s_senace_pole_visual" aria-hidden="true">
                                    <img src="/senodoo_website_landing/static/src/img/icon-entreprises.webp"
                                         alt="" width="512" height="512" loading="lazy"
                                         decoding="async"/>
                                </div>
                            </article>

                            <article id="tourisme" class="s_senace_pole s_senace_pole--tourisme">
                                <div class="s_senace_pole_copy">
                                    <p class="s_senace_pole_overline"><span>04</span> Coordonner</p>
                                    <h3>Services au tourisme</h3>
                                    <p>
                                        Des prestations liées au tourisme coordonnées avec soin,
                                        de la compréhension de votre demande jusqu'à sa réalisation.
                                    </p>
                                    <ul class="list-unstyled s_senace_pole_points">
                                        <li>Accompagnement de projet</li>
                                        <li>Coordination de prestations</li>
                                        <li>Suivi de bout en bout</li>
                                    </ul>
                                    <a href="/contactus?subject=Services au tourisme"
                                       class="s_senace_link">
                                        Parler de mon projet
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                                <div class="s_senace_pole_visual" aria-hidden="true">
                                    <img src="/senodoo_website_landing/static/src/img/icon-tourisme.webp"
                                         alt="" width="512" height="512" loading="lazy"
                                         decoding="async"/>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>

                <!-- ============ Approche ============ -->
                <section id="approche" class="s_senace_section s_senace_approach"
                         aria-labelledby="senace-approach-title">
                    <div class="container">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-4">
                                <div class="s_senace_approach_media">
                                    <img src="/senodoo_website_landing/static/src/img/senace-coaching.webp"
                                         alt="" width="1122" height="1402" loading="lazy"
                                         decoding="async" aria-hidden="true"/>
                                    <div class="s_senace_media_note">
                                        <span>Notre parti pris</span>
                                        <strong>L'humain d'abord.</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-7 offset-lg-1">
                                <p class="s_senace_kicker">Une expertise qui s'adapte</p>
                                <h2 id="senace-approach-title">
                                    Des solutions pensées pour votre réalité,
                                    <span>pas pour une situation théorique.</span>
                                </h2>
                                <p class="s_senace_approach_lead">
                                    Nous écoutons, cadrons et avançons avec vous, dans une relation
                                    simple et directement utile.
                                </p>
                                <div class="s_senace_benefits">
                                    <div class="s_senace_benefit">
                                        <span>01</span>
                                        <div>
                                            <h3>Sur mesure</h3>
                                            <p>Chaque mission part de vos priorités réelles.</p>
                                        </div>
                                    </div>
                                    <div class="s_senace_benefit">
                                        <span>02</span>
                                        <div>
                                            <h3>Lisible</h3>
                                            <p>Le périmètre et les prochaines étapes sont clairs.</p>
                                        </div>
                                    </div>
                                    <div class="s_senace_benefit">
                                        <span>03</span>
                                        <div>
                                            <h3>Proche</h3>
                                            <p>Un interlocuteur unique, disponible à Dakar.</p>
                                        </div>
                                    </div>
                                    <div class="s_senace_benefit">
                                        <span>04</span>
                                        <div>
                                            <h3>Suivi</h3>
                                            <p>Nous restons présents jusqu'au bilan.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ Methode ============ -->
                <section id="methode" class="s_senace_section s_senace_method"
                         aria-labelledby="senace-method-title">
                    <div class="container">
                        <div class="row align-items-end g-4 s_senace_method_head">
                            <div class="col-lg-7">
                                <p class="s_senace_kicker">Notre méthode</p>
                                <h2 id="senace-method-title">
                                    Une trajectoire claire,<br/>
                                    du besoin au résultat.
                                </h2>
                            </div>
                            <div class="col-lg-4 offset-lg-1">
                                <p>
                                    Quatre étapes structurent chaque intervention et vous donnent
                                    de la visibilité, sans alourdir le projet.
                                </p>
                            </div>
                        </div>
                        <ol class="row g-0 list-unstyled s_senace_steps">
                            <li class="col-md-6 col-xl-3">
                                <article class="s_senace_step">
                                    <span class="s_senace_step_num">01</span>
                                    <h3>Échange</h3>
                                    <p>Votre contexte, vos objectifs et vos priorités sont posés sans jargon.</p>
                                </article>
                            </li>
                            <li class="col-md-6 col-xl-3">
                                <article class="s_senace_step">
                                    <span class="s_senace_step_num">02</span>
                                    <h3>Proposition</h3>
                                    <p>Un périmètre, un programme et un devis clairs avant le démarrage.</p>
                                </article>
                            </li>
                            <li class="col-md-6 col-xl-3">
                                <article class="s_senace_step">
                                    <span class="s_senace_step_num">03</span>
                                    <h3>Réalisation</h3>
                                    <p>L'intervention avance avec des points d'étape utiles et concrets.</p>
                                </article>
                            </li>
                            <li class="col-md-6 col-xl-3">
                                <article class="s_senace_step">
                                    <span class="s_senace_step_num">04</span>
                                    <h3>Suivi</h3>
                                    <p>Nous faisons le bilan et restons disponibles pour consolider la suite.</p>
                                </article>
                            </li>
                        </ol>
                    </div>
                </section>

                <!-- ============ Conversion ============ -->
                <section id="contact" class="s_senace_section s_senace_contact"
                         aria-labelledby="senace-contact-title">
                    <div class="container">
                        <div class="s_senace_contact_panel">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-7">
                                    <p class="s_senace_kicker">Passons à l'action</p>
                                    <h2 id="senace-contact-title">
                                        Votre prochain cap commence<br/>
                                        par une conversation.
                                    </h2>
                                    <p>
                                        Quelques lignes suffisent pour nous présenter votre besoin.
                                        Nous vous recontactons avec une proposition adaptée.
                                    </p>
                                </div>
                                <div class="col-lg-4 offset-lg-1">
                                    <div class="s_senace_contact_actions">
                                        <a href="/contactus" class="btn s_senace_btn_light">
                                            Nous parler de votre projet
                                            <i class="fa fa-arrow-right" aria-hidden="true"/>
                                        </a>
                                        <a href="tel:+221771100301"
                                           class="s_senace_phone_link">
                                            <i class="fa fa-phone" aria-hidden="true"/>
                                            <span class="o_force_ltr">77 110 03 01</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="s_senace_contact_meta">
                                <a href="mailto:kadycoulibaly43@yahoo.fr">
                                    <i class="fa fa-envelope-o" aria-hidden="true"/>
                                    <span>kadycoulibaly43@yahoo.fr</span>
                                </a>
                                <div>
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                    <span>Keur Massar, Dakar · Sénégal</span>
                                </div>
                                <div>
                                    <i class="fa fa-handshake-o" aria-hidden="true"/>
                                    <span>Premier échange sans engagement</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </xpath>
    </template>

</odoo>
