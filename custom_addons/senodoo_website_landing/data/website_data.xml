<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : valeur de depart seulement. Si vous renommez le site
         depuis Odoo, une mise a jour du module ne l'ecrasera pas. -->
    <data noupdate="1">
        <record id="website.default_website" model="website">
            <field name="name">SENACE</field>
        </record>
    </data>

    <!-- Navigation courte, utile sur ordinateur comme dans le menu mobile. -->
    <data>
        <record id="menu_senace_expertises" model="website.menu">
            <field name="name">Nos expertises</field>
            <field name="url">/#poles</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>
        <record id="menu_senace_approche" model="website.menu">
            <field name="name">Notre approche</field>
            <field name="url">/#approche</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">30</field>
        </record>
        <record id="menu_senace_methode" model="website.menu">
            <field name="name">Nos accréditations et agréments</field>
            <field name="url">/#methode</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">40</field>
        </record>
    </data>

    <!--
      Odoo duplique l'arbre de menus par site des la premiere personnalisation
      (copy-on-write). Le <record> ci-dessus ne touche que l'exemplaire
      generique portant l'identifiant XML ; la copie rattachee au site, qui est
      celle reellement affichee, garderait son ancien libelle. On renomme donc
      par URL, ce qui atteint les deux.

      Contrepartie assumee : un renommage fait depuis l'editeur de site sera
      ecrase a la prochaine mise a jour du module.
    -->
    <data>
        <function model="website.menu" name="write">
            <function model="website.menu" name="search"
                      eval="[[('url', '=', '/#methode')]]"/>
            <value eval="{'name': 'Nos accréditations et agréments'}"/>
        </function>
    </data>

    <!--
      website_slides, website_hr_recruitment et website_event ajoutent chacun
      leur entree au menu principal a l'installation : Cours (/slides),
      Postes (/jobs), Evenements (/event). SENACE ne publie ni cours en ligne
      ni offres d'emploi ni evenements : ces entrees menent a des pages vides.

      On supprime les enregistrements plutot que de masquer les liens en CSS :
      le menu mobile et le plan du site les reprendraient. La recherche porte
      sur l'URL et non sur l'identifiant XML, pour ne pas echouer si l'un de
      ces modules n'est pas installe sur la base visee.

      Ce bloc s'execute a chaque mise a jour du module : si l'un de ces
      modules recree son menu lors de sa propre mise a jour, le deploiement
      suivant le retirera de nouveau.
    -->
    <data>
        <delete model="website.menu" search="[('url', 'in', ['/slides', '/jobs', '/event'])]"/>
    </data>
</odoo>
