# ============================================================================
# Modele de configuration locale pour docker-compose.
#
#   cp .env.example .env   puis editer .env
#
# .env est ignore par git (regle `.*` dans .gitignore) : ne jamais y mettre
# de secrets destines a la production - ceux-ci se declarent dans l'interface
# Render / Railway.
# ============================================================================

# --- PostgreSQL (service `db` de docker-compose) ---------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=odoo

# --- Odoo ------------------------------------------------------------------
# Mot de passe maitre : protege la creation, la duplication et la suppression
# de bases de donnees. Obligatoirement different de 'admin'.
ODOO_ADMIN_PASSWD=changeme_admin_password

# Port publie sur la machine hote (http://localhost:8069)
ODOO_PORT=8069

# 0 = mode threade (HTTP + websocket sur un seul port).
# > 0 = mode prefork : reserve aux VPS, car le worker gevent ouvre un second
# port. Ne pas activer sur Render/Railway.
ODOO_WORKERS=0

# True uniquement derriere un reverse proxy qui envoie les en-tetes
# X-Forwarded-*. En acces direct sur localhost:8069, laisser False.
ODOO_PROXY_MODE=False

# debug | info | warn | error
ODOO_LOG_LEVEL=info

# Modules a installer au demarrage. L'entrypoint verifie d'abord leur etat en
# base : la variable peut rester en place sans ralentir les redemarrages.
ODOO_INSTALL_MODULES=senodoo_app_upgrade

# Chemin d'addons supplementaire, ajoute apres addons/ et custom_addons/.
# Exemple : les addons Odoo Enterprise si vous disposez d'un abonnement.
# ODOO_EXTRA_ADDONS_PATH=/mnt/enterprise
