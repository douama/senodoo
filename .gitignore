# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json
# fichiers de deploiement conteneurise : doivent etre versionnes, sinon
# Render/Railway construiraient l'image sans exclusions (.venv, .git, ...)
!.dockerignore
!.env.example
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf
# sauvegardes de odoo.conf produites par windows/Install-Odoo.ps1
/odoo.conf.bak-*

# artefacts du kit d'installation Windows
# (.venv-win est deja couvert par la regle .* ci-dessus)
/windows/logs/
/windows/tools/

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/
